<Window x:Class="WeekNumberTray.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Week Number Tray"
        Icon="pack://application:,,,/app.ico"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <DockPanel>
            <Image Source="pack://application:,,,/app.ico" Width="48" Height="48" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Week Number Tray" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="Shows the current ISO 8601 week number in the notification area. Click the icon to open a calendar with week numbers." />
        <Button Margin="0,20,0,0" HorizontalAlignment="Right" MinWidth="80" Content="OK"
                IsDefault="True" IsCancel="True" Click="OnOk" />
    </StackPanel>
</Window>
