<Window x:Class="WeekNumberTray.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Week Number"
        Width="312"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontSize="14"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnKeyDown"
        MouseWheel="OnMouseWheel">

    <Window.Resources>
        <!-- Not focusable, so the arrow keys always change the month instead of moving focus. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="22" />
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Root" Margin="0,12,0,4">
        <Grid Margin="12,0" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ArrowButton}" Content="&#x2039;" Click="OnPreviousMonth"
                    ToolTip="Previous month" />
            <TextBlock x:Name="MonthTitle" Grid.Column="1" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource ArrowButton}" Content="&#x203A;" Click="OnNextMonth"
                    ToolTip="Next month" />
        </Grid>

        <!-- Filled in by CalendarWindow.Rebuild: a row of day names, then six weeks. -->
        <Grid x:Name="MonthGrid" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
        </Grid>

        <Button Style="{StaticResource FlatButton}" Margin="12,2" Height="30" Padding="8,0"
                HorizontalContentAlignment="Left" Click="OnToday">
            <TextBlock x:Name="TodayText" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Button>

        <Border Height="1" Margin="0,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Button Style="{StaticResource MenuButton}" Click="OnToggleAutoStart">
            <DockPanel>
                <TextBlock x:Name="AutoStartCheck" DockPanel.Dock="Right" Text="&#x2713;" />
                <TextBlock Text="Start with Windows" />
            </DockPanel>
        </Button>
        <Button Style="{StaticResource MenuButton}" Click="OnCheckForUpdates">
            <TextBlock Text="Check for updates" />
        </Button>
        <Button Style="{StaticResource MenuButton}" Click="OnAbout">
            <TextBlock Text="About" />
        </Button>
        <Button Style="{StaticResource MenuButton}" Click="OnExit">
            <TextBlock Text="Exit" />
        </Button>
    </StackPanel>
</Window>
